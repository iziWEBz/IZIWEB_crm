diff --git a/Dockerfile.nginx.prod b/Dockerfile.nginx.prod
new file mode 100644
index 0000000..e18418f
--- /dev/null
+++ b/Dockerfile.nginx.prod
@@ -0,0 +1,14 @@
+# Production nginx for the API (compose.coolify.yaml). public/ and the built
+# Vite assets are baked in; PHP runs in the `api` service.
+FROM docker.io/library/node:22-alpine AS assets
+WORKDIR /app
+COPY package.json ./
+RUN npm install --no-audit --no-fund
+COPY vite.config.js ./
+COPY resources ./resources
+RUN npm run build
+
+FROM docker.io/library/nginx:alpine
+COPY public /app/public
+COPY --from=assets /app/public/build /app/public/build
+COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
diff --git a/Dockerfile.prod b/Dockerfile.prod
new file mode 100644
index 0000000..24e0715
--- /dev/null
+++ b/Dockerfile.prod
@@ -0,0 +1,55 @@
+# Production image for Coolify (compose.coolify.yaml): php-fpm only, paired
+# with the `nginx` service (Dockerfile.nginx.prod). The development setup —
+# Dockerfile + docker-compose.yml with the code bind-mounted — is unchanged.
+
+# 1. PHP dependencies, without dev packages. vendor/ in the repository is not
+#    used: .dockerignore keeps it out, so the image never depends on it.
+FROM docker.io/library/composer:2 AS vendor
+WORKDIR /app
+COPY composer.json composer.lock ./
+RUN composer install --no-dev --no-scripts --no-interaction --prefer-dist --optimize-autoloader --ignore-platform-req='ext-*'
+
+# 2. Front-end assets (Vite). The welcome page uses @vite, so the manifest
+#    must exist in the image or the page fails.
+FROM docker.io/library/node:22-alpine AS assets
+WORKDIR /app
+COPY package.json ./
+RUN npm install --no-audit --no-fund
+COPY vite.config.js ./
+COPY resources ./resources
+RUN npm run build
+
+# 3. Runtime.
+FROM docker.io/library/php:8.2-fpm-alpine
+
+RUN apk add --no-cache libpq libpng libjpeg-turbo freetype libzip \
+    && apk add --no-cache --virtual .build-deps $PHPIZE_DEPS postgresql-dev libpng-dev libjpeg-turbo-dev freetype-dev libzip-dev \
+    && docker-php-ext-configure gd --with-freetype --with-jpeg \
+    && docker-php-ext-install pdo_pgsql pgsql zip gd bcmath opcache \
+    && apk del .build-deps
+
+RUN { \
+    echo 'opcache.enable=1'; \
+    echo 'opcache.validate_timestamps=0'; \
+    echo 'opcache.max_accelerated_files=20000'; \
+    echo 'opcache.memory_consumption=192'; \
+    } > /usr/local/etc/php/conf.d/opcache-prod.ini \
+    && printf 'upload_max_filesize=20M\npost_max_size=20M\n' > /usr/local/etc/php/conf.d/uploads.ini \
+    && sed -i 's/^user = www-data/;&/; s/^group = www-data/;&/' /usr/local/etc/php-fpm.d/www.conf
+
+WORKDIR /app
+COPY . .
+COPY --from=vendor /app/vendor ./vendor
+COPY --from=assets /app/public/build ./public/build
+
+RUN php artisan package:discover --ansi \
+    && mkdir -p storage/api-docs storage/framework/cache/data storage/framework/sessions storage/framework/views storage/logs \
+    && chown -R www-data:www-data storage bootstrap/cache
+
+COPY docker/entrypoint.prod.sh /usr/local/bin/entrypoint.prod.sh
+RUN chmod +x /usr/local/bin/entrypoint.prod.sh
+
+USER www-data
+EXPOSE 9000
+ENTRYPOINT ["entrypoint.prod.sh"]
+CMD ["php-fpm"]
diff --git a/compose.coolify.yaml b/compose.coolify.yaml
new file mode 100644
index 0000000..dec86b4
--- /dev/null
+++ b/compose.coolify.yaml
@@ -0,0 +1,69 @@
+# Production stack for Coolify (build pack "Docker Compose",
+# Docker Compose Location: /compose.coolify.yaml).
+#
+# - The database is a separate Coolify resource (PostgreSQL), so its scheduled
+#   backups are configured in Coolify. The app reaches it over Coolify's shared
+#   network: Advanced → "Predefined network" on, and DB_URL = the database's
+#   "Postgres URL (internal)".
+# - The domain is set on the `nginx` service in the Coolify UI (https://…);
+#   SERVICE_URL_NGINX_80 tells Coolify the container and port, APP_URL follows it.
+# - APP_KEY is generated by Coolify on the first deploy.
+# - Migrations (including the roles/permissions seed) run in `api` on start.
+# - No queue worker, scheduler or Redis: the app has no queued jobs or scheduled
+#   tasks, and cache/sessions/queue use the database (Laravel 12 defaults).
+#   Add `queue` / `scheduler` services here when that changes.
+#
+# The development setup (Dockerfile + docker-compose.yml) is separate and unchanged.
+
+services:
+  api:
+    build:
+      context: .
+      dockerfile: Dockerfile.prod
+    restart: unless-stopped
+    environment:
+      APP_NAME: ${APP_NAME:-IZIWEB CRM}
+      APP_ENV: production
+      APP_DEBUG: "false"
+      # 32 random characters — Laravel accepts a raw 32-byte key without "base64:".
+      # Generated once; changing it invalidates sessions and encrypted data.
+      APP_KEY: ${SERVICE_BASE64_APPKEY}
+      APP_URL: ${SERVICE_URL_NGINX}
+      DB_CONNECTION: pgsql
+      # Copy "Postgres URL (internal)" from the database resource in Coolify.
+      DB_URL: ${DB_URL:?Set DB_URL to the database's internal URL}
+      SESSION_SECURE_COOKIE: "true"
+      LOG_CHANNEL: stderr
+      MAIL_MAILER: ${MAIL_MAILER:-log}
+      RUN_MIGRATIONS: "true"
+    volumes:
+      - apidata:/app/storage/app
+    healthcheck:
+      test: ["CMD-SHELL", "nc -z 127.0.0.1 9000 || exit 1"]
+      interval: 15s
+      timeout: 5s
+      retries: 3
+      start_period: 60s
+
+  nginx:
+    build:
+      context: .
+      dockerfile: Dockerfile.nginx.prod
+    restart: unless-stopped
+    # Declared so Coolify recognises the port its Traefik must route to.
+    expose:
+      - "80"
+    environment:
+      - SERVICE_URL_NGINX_80
+    depends_on:
+      api:
+        condition: service_healthy
+    healthcheck:
+      test: ["CMD-SHELL", "wget -qO /dev/null http://127.0.0.1/up || exit 1"]
+      interval: 15s
+      timeout: 5s
+      retries: 3
+      start_period: 30s
+
+volumes:
+  apidata:
diff --git a/docker/entrypoint.prod.sh b/docker/entrypoint.prod.sh
new file mode 100644
index 0000000..7a87aba
--- /dev/null
+++ b/docker/entrypoint.prod.sh
@@ -0,0 +1,19 @@
+#!/bin/sh
+set -e
+
+# Config/route/view caches are built at start, not in the image: the build has
+# no APP_KEY, DB_URL or any other runtime value, and a cache built without them
+# would freeze empty settings into the container.
+php artisan config:cache
+php artisan route:cache
+php artisan view:cache
+
+# Swagger documentation (storage/api-docs) is generated from the annotations
+# in the code. A failure here must not keep the API down.
+php artisan l5-swagger:generate || echo "WARNING: l5-swagger:generate failed, API docs are unavailable"
+
+if [ "${RUN_MIGRATIONS:-false}" = "true" ]; then
+    php artisan migrate --force
+fi
+
+exec "$@"
diff --git a/docker/nginx/prod.conf b/docker/nginx/prod.conf
new file mode 100644
index 0000000..c74de02
--- /dev/null
+++ b/docker/nginx/prod.conf
@@ -0,0 +1,41 @@
+# Production nginx for compose.coolify.yaml. Serves public/ (baked into the
+# image) and passes PHP to the `api` service over FastCGI.
+server {
+    listen 80;
+    server_name _;
+    root /app/public;
+    index index.php;
+    client_max_body_size 20m;
+
+    # Docker's DNS; re-resolving `api` means a redeployed api container is
+    # picked up without restarting nginx.
+    resolver 127.0.0.11 valid=10s ipv6=off;
+    set $php_upstream api:9000;
+
+    location = /up {
+        try_files $uri /index.php?$query_string;
+        access_log off;
+    }
+
+    location / {
+        try_files $uri $uri/ /index.php?$query_string;
+    }
+
+    location /build/ {
+        add_header Cache-Control "public, max-age=31536000, immutable";
+        try_files $uri =404;
+    }
+
+    location ~ \.php$ {
+        fastcgi_pass $php_upstream;
+        fastcgi_index index.php;
+        include fastcgi_params;
+        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
+        fastcgi_hide_header X-Powered-By;
+        fastcgi_read_timeout 60s;
+    }
+
+    location ~ /\.(?!well-known).* {
+        deny all;
+    }
+}
